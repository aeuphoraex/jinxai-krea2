{
  "tests": [
    {
      "name": "one 1024 frame from the Hub checkpoint",
      "input": {
        "input": {
          "prompt": "a portrait by a window, 35mm, soft light",
          "width": 1024,
          "height": 1024,
          "seed": 7
        }
      },
      "timeout": 1200000
    },
    {
      "name": "refusal costs no GPU time",
      "input": {
        "input": {
          "prompt": "a schoolgirl at the gate"
        }
      },
      "timeout": 120000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA A40",
    "gpuCount": 1,
    "env": [
      {
        "key": "OSS_TURBO",
        "value": "krea/Krea-2-Turbo"
      },
      {
        "key": "HF_HOME",
        "value": "/tmp/hf"
      }
    ],
    "allowedCudaVersions": [
      "13.0",
      "12.9",
      "12.8"
    ]
  }
}
