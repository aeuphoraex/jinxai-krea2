{
  "tests": [
    {
      "name": "one 1024 frame from the Hub checkpoint",
      "input": {
        "prompt": "a portrait by a window, 35mm, soft light",
        "width": 1024,
        "height": 1024,
        "seed": 7
      },
      "timeout": 1200000
    },
    {
      "name": "refusal costs no GPU time",
      "input": {
        "prompt": "a schoolgirl at the gate"
      },
      "timeout": 120000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA A40",
    "gpuCount": 1,
    "env": [
      {
        "key": "OSS_TURBO",
        "value": "Comfy-Org/Krea-2::diffusion_models/krea2_turbo_bf16.safetensors"
      },
      {
        "key": "HF_HOME",
        "value": "/tmp/hf"
      }
    ],
    "allowedCudaVersions": [
      "13.2",
      "13.0",
      "12.9",
      "12.8",
      "12.7",
      "12.6"
    ]
  }
}
